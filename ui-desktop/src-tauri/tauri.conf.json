{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CitriPass Desktop Host",
  "version": "0.1.0",
  "identifier": "app.citripass.desktop-host",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "CitriPass 验证宿主",
        "width": 1180,
        "height": 840,
        "minWidth": 860,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
